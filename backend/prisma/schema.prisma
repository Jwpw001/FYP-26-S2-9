/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model timesheets {
  timesheet_id  Int       @id @default(autoincrement())
  staff_id      Int
  log_date      DateTime  @db.Date
  hours_worked  Decimal   @db.Decimal(4, 1)
  description   String?
  status        String    @default("pending") @db.VarChar(20)
  reviewed_by   Int?
  reviewed_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  shift_id      Int?
  evidence_path String?
  evidence_name String?
  // Round 3, Task 4: actual worked from/to time, distinct from the rostered shift/task window.
  // Nullable, no default — every existing row has neither (they only ever recorded
  // hours_worked), and application code must keep tolerating that: when either is null, worked/
  // additional/overtime hours are reported as unknown, falling back to hours_worked for the
  // worked-hours figure only. When both are present, hours_worked is derived from them at
  // submission time (see timesheetController.submitReport) so every existing reader of
  // hours_worked keeps working unchanged.
  start_time    DateTime? @db.Time(6)
  end_time      DateTime? @db.Time(6)
  // Round 6, Task 3: unpaid break within the actual start/end span, minutes. Nullable, no
  // default/backfill — every existing row reads as null, treated identically to 0 (no break) by
  // computeHoursMetrics. Only meaningful alongside start_time/end_time; position within the shift
  // isn't recorded, only length (see hoursMetrics.js's own comment on why overtime is therefore
  // computed on the raw span, never net of break).
  break_minutes Int?
  users         users?    @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)
  staff         staff     @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)
}


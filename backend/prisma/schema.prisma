generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  user_id          String    @id(map: "Users_pkey") @db.Uuid
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  outlet_id        String?   @db.Uuid
  username         String
  email            String    @unique(map: "Users_email_key") @db.VarChar(255)
  role             String
  is_active        Boolean?  @default(true)
  supabase_auth_id String    @unique(map: "users_supabase_auth_id_unique") @db.Uuid
  outlet           Outlets?  @relation(fields: [outlet_id], references: [outlet_id], onUpdate: NoAction, map: "fk_user_outlet")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Business {
  business_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  business_name String    @db.VarChar(255)
  address       String?   @db.VarChar(255)
  industry_type String?
  contact_info  String?   @db.VarChar(255)
  Outlets       Outlets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Outlets {
  outlet_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  business_id String    @db.Uuid
  name        String
  address     String?   @db.VarChar(255)
  is_active   String?   @default("active") @db.VarChar(20)
  Business    Business  @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet_business")
  users       users[]
}

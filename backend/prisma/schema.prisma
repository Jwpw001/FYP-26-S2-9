generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  attendance_id     Int      @id @default(autoincrement())
  shift_id          Int
  krewby_worker_id  Int
  attendance_status String   @db.VarChar(10)
  marked_by         Int
  marked_at         DateTime @default(now()) @db.Timestamp(6)

  @@unique([shift_id, krewby_worker_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability {
  request_id  Int       @id @default(autoincrement())
  staff_id    Int
  leave_type  String    @db.VarChar(20)
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  reason      String?
  status      String    @default("pending") @db.VarChar(20)
  reviewed_by Int?
  reviewed_at DateTime? @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model casual_availability {
  availability_id Int       @id @default(autoincrement())
  staff_id        Int
  week_start_date DateTime  @db.Date
  day_of_week     Int       @db.SmallInt
  available_from  DateTime? @db.Time(6)
  available_to    DateTime? @db.Time(6)

  @@unique([staff_id, week_start_date, day_of_week])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model krewby_workers {
  krewby_worker_id    Int       @id @default(autoincrement())
  user_id             Int       @unique
  full_name           String    @db.VarChar(150)
  email               String    @unique @db.VarChar(150)
  phone_number        String    @db.VarChar(20)
  identification_info String
  preferred_location  String?
  account_status      String    @default("Active") @db.VarChar(20)
  rating              Decimal?  @default(0.00) @db.Decimal(4, 2)
  no_show_count       Int?      @default(0)
  total_jobs          Int?      @default(0)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
}

model outlets {
  outlet_id   Int        @id @default(autoincrement())
  business_id Int
  outlet_name String
  address     String
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  businesses  businesses @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet_business")
}

model reports {
  report_id    Int      @id @default(autoincrement())
  outlet_id    Int
  generated_by Int
  report_type  String   @db.VarChar(50)
  period_start DateTime @db.Date
  period_end   DateTime @db.Date
  parameters   Json?
  result_data  Json?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shift_assignments {
  assignment_id                                                   Int             @id @default(autoincrement())
  shift_id                                                        Int
  role_id                                                         Int
  staff_id                                                        Int?
  krewby_worker_id                                                Int?
  status                                                          String          @default("assigned") @db.VarChar(20)
  assigned_at                                                     DateTime?       @default(now()) @db.Timestamp(6)
  swap_requests_swap_requests_requester_assignToshift_assignments swap_requests[] @relation("swap_requests_requester_assignToshift_assignments")
  swap_requests_swap_requests_target_assign_idToshift_assignments swap_requests[] @relation("swap_requests_target_assign_idToshift_assignments")

  @@index([shift_id], map: "idx_assignments_shift")
  @@index([staff_id], map: "idx_assignments_staff")
}

model shift_roles {
  shift_role_id      Int    @id @default(autoincrement())
  shift_id           Int
  skill_tag_id       Int
  required_headcount Int
  shifts             shifts @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_shift_role_shift")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shifts {
  shift_id             Int                    @id @default(autoincrement())
  shift_date           DateTime               @db.Date
  start_time           DateTime               @db.Time(6)
  end_time             DateTime               @db.Time(6)
  outlet_location      String                 @db.VarChar(100)
  status               String                 @db.VarChar(15)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  replacement_requests replacement_requests[]
  shift_roles          shift_roles[]
  shift_swap_requests  shift_swap_requests[]
}

model skills {
  skill_id    Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  description String?
  created_by  Int?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff {
  staff_id          Int       @id @default(autoincrement())
  user_id           Int
  outlet_id         Int
  staff_type        String    @db.VarChar(20)
  default_work_days String?   @db.VarChar(7)
  hired_at          DateTime? @db.Date
  is_active         Boolean?  @default(true)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model swap_requests {
  swap_id                                                             Int                @id @default(autoincrement())
  requester_id                                                        Int
  requester_assign                                                    Int
  target_staff_id                                                     Int?
  target_assign_id                                                    Int?
  request_type                                                        String             @db.VarChar(20)
  reason                                                              String?
  status                                                              String             @default("pending") @db.VarChar(30)
  responded_at                                                        DateTime?          @db.Timestamp(6)
  manager_id                                                          Int?
  manager_decided_at                                                  DateTime?          @db.Timestamp(6)
  shift_assignments_swap_requests_requester_assignToshift_assignments shift_assignments  @relation("swap_requests_requester_assignToshift_assignments", fields: [requester_assign], references: [assignment_id], onDelete: NoAction, onUpdate: NoAction)
  shift_assignments_swap_requests_target_assign_idToshift_assignments shift_assignments? @relation("swap_requests_target_assign_idToshift_assignments", fields: [target_assign_id], references: [assignment_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requester_id], map: "idx_swap_requester")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id    Int       @id @default(autoincrement())
  username   String    @db.VarChar(150)
  email      String    @unique @db.VarChar(150)
  role       String    @db.VarChar(30)
  is_active  Boolean   @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model availability_slot {
  slot_id             Int                 @id @default(autoincrement())
  availability_id     Int
  work_area           String?             @db.VarChar(100)
  available_date      DateTime            @db.Date
  start_time          DateTime            @db.Time(6)
  end_time            DateTime            @db.Time(6)
  worker_availability worker_availability @relation(fields: [availability_id], references: [availability_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model businesses {
  business_id   Int       @id @default(autoincrement())
  business_name String
  address       String
  industry_type String
  contact_info  String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  outlets       outlets[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model krewby_casual_worker {
  worker_id             Int                   @id @default(autoincrement())
  full_name             String                @db.VarChar(150)
  email                 String?               @unique @db.VarChar(150)
  phone_number          String                @db.VarChar(30)
  identification_number String                @unique @db.VarChar(50)
  account_status        String                @default("ACTIVE") @db.VarChar(20)
  average_rating        Decimal?              @default(0.00) @db.Decimal(4, 2)
  no_show_count         Int?                  @default(0)
  created_at            DateTime?             @default(now()) @db.Timestamp(6)
  updated_at            DateTime?             @default(now()) @db.Timestamp(6)
  worker_availability   worker_availability[]
  worker_skill_tags     worker_skill_tags[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model krewby_request {
  request_id            Int       @id @default(autoincrement())
  outlet_manager_id     Int
  required_skill_tag_id Int
  role_name             String?   @db.VarChar(100)
  outlet_address        String?
  shift_date            DateTime? @db.Date
  start_time            DateTime? @db.Time(6)
  end_time              DateTime? @db.Time(6)
  required_headcount    Int?
  request_status        String?   @default("PENDING_REVIEW") @db.VarChar(20)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model replacement_requests {
  replacement_request_id Int       @id @default(autoincrement())
  shift_id               Int
  requester_id           Int
  reason                 String
  manager_status         String    @default("Pending") @db.VarChar(10)
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  shifts                 shifts    @relation(fields: [shift_id], references: [shift_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shift_swap_requests {
  swap_request_id    Int       @id @default(autoincrement())
  shift_id           Int
  requester_id       Int
  nominated_staff_id Int
  colleague_status   String    @default("Pending") @db.VarChar(10)
  manager_status     String    @default("Pending") @db.VarChar(10)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  shifts             shifts    @relation(fields: [shift_id], references: [shift_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model skill_tags {
  skill_tag_id    Int               @id @default(autoincrement())
  tag_name        String            @unique
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  user_skill_tags user_skill_tags[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model staff_profiles {
  staff_profile_id  Int    @id @default(autoincrement())
  user_id           Int    @unique
  staff_type        String @db.VarChar(20)
  outlet_manager_id Int?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_skill_tags {
  user_id      Int
  skill_tag_id Int
  skill_tags   skill_tags @relation(fields: [skill_tag_id], references: [skill_tag_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ust_skill")

  @@id([user_id, skill_tag_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model worker_availability {
  availability_id      Int                  @id @default(autoincrement())
  worker_id            Int
  week_start_date      DateTime             @db.Date
  availability_slot    availability_slot[]
  krewby_casual_worker krewby_casual_worker @relation(fields: [worker_id], references: [worker_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model worker_skill_tags {
  worker_id            Int
  skill_id             Int
  krewby_casual_worker krewby_casual_worker @relation(fields: [worker_id], references: [worker_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([worker_id, skill_id])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id         Int               @id @default(autoincrement())
  username        String            @db.VarChar(100)
  email           String            @unique @db.VarChar(100)
  role            String            @db.VarChar(30)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  full_name       String?           @db.VarChar(100)
  attendance      attendance[]
  availability    availability[]
  invitations     invitations[]
  notifications   notifications[]
  reports         reports[]
  shifts          shifts[]
  skills          skills[]
  staff           staff[]
  swap_requests   swap_requests[]
  user_skill_tags user_skill_tags[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  attendance_id    Int              @id @default(autoincrement())
  assignment_id    Int
  clock_in         DateTime?        @db.Timestamp(6)
  clock_out        DateTime?        @db.Timestamp(6)
  status           String           @default("pending") @db.VarChar(20)
  marked_by        Int
  marked_at        DateTime?        @default(now()) @db.Timestamp(6)
  task_assignments task_assignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade, onUpdate: NoAction)
  users            users            @relation(fields: [marked_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability {
  request_id  Int       @id @default(autoincrement())
  staff_id    Int
  leave_type  String    @db.VarChar(20)
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  reason      String?
  status      String    @default("pending") @db.VarChar(20)
  reviewed_by Int?
  reviewed_at DateTime? @db.Timestamp(6)
  users       users?    @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)
  staff       staff     @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model casual_availability {
  availability_id Int       @id @default(autoincrement())
  staff_id        Int
  week_start_date DateTime  @db.Date
  day_of_week     Int       @db.SmallInt
  available_from  DateTime? @db.Time(6)
  available_to    DateTime? @db.Time(6)

  @@unique([staff_id, week_start_date, day_of_week])
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  recipient_id    Int
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  message         String?
  related_entity  String?   @db.VarChar(50)
  related_id      Int?
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [recipient_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model branches {
  branch_id             Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  address               String?
  business_id           Int?
  open_time             DateTime?               @db.Time
  close_time            DateTime?               @db.Time
  reports               reports[]
  shifts                shifts[]
  skills                skills[]
  staff                 staff[]
  branch_role_templates branch_role_templates[]
  branch_skills         branch_skills[]
}

model branch_role_templates {
  template_id Int      @id @default(autoincrement())
  branch_id   Int
  role_name   String   @db.VarChar(100)
  skill_id    Int?
  headcount   Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamptz
  branches    branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade)
  skills      skills?  @relation(fields: [skill_id], references: [skill_id], onDelete: SetNull)
}

model reports {
  report_id    Int      @id @default(autoincrement())
  branch_id    Int
  generated_by Int
  report_type  String   @db.VarChar(50)
  period_start DateTime @db.Date
  period_end   DateTime @db.Date
  parameters   Json?
  result_data  Json?
  users        users    @relation(fields: [generated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  branches     branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
}

model shifts {
  shift_id         Int                @id @default(autoincrement())
  branch_id        Int
  title            String?            @db.VarChar(100)
  shift_date       DateTime           @db.Date
  start_time       DateTime           @db.Time(6)
  end_time         DateTime           @db.Time(6)
  deadline         DateTime?          @db.Date
  status           String             @default("draft") @db.VarChar(20)
  created_by       Int?
  shift_tasks      shift_tasks[]
  task_assignments task_assignments[]
  users            users?             @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  branches         branches           @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([branch_id, shift_date], map: "idx_shifts_outlet_date")
}

model shift_tasks {
  task_id          Int                @id @default(autoincrement())
  shift_id         Int
  title            String             @db.VarChar(100)
  description      String?
  skill_id         Int?
  difficulty       String?            @db.VarChar(20)
  start_time       DateTime?          @db.Time(6)
  end_time         DateTime?          @db.Time(6)
  status           String             @default("open") @db.VarChar(20)
  task_assignments task_assignments[]
  shifts           shifts             @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  skills           skills?            @relation(fields: [skill_id], references: [skill_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([shift_id], map: "idx_shift_tasks_shift")
}

model task_assignments {
  assignment_id                                                             Int              @id @default(autoincrement())
  task_id                                                                   Int
  shift_id                                                                  Int
  staff_id                                                                  Int?
  status                                                                    String           @default("assigned") @db.VarChar(20)
  acknowledged                                                              Boolean?         @default(false)
  assigned_at                                                               DateTime?        @default(now()) @db.Timestamp(6)
  attendance                                                                attendance[]
  shift_tasks                                                               shift_tasks      @relation(fields: [task_id], references: [task_id], onDelete: Cascade, onUpdate: NoAction)
  shifts                                                                    shifts           @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  staff                                                                     staff?           @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
  swap_requests_swap_requests_requester_assignTotask_assignments            swap_requests[]  @relation("swap_requests_requester_assignTotask_assignments")
  swap_requests_swap_requests_target_assign_idTotask_assignments            swap_requests[]  @relation("swap_requests_target_assign_idTotask_assignments")

  @@index([shift_id], map: "idx_task_assignments_shift")
  @@index([staff_id], map: "idx_task_assignments_staff")
}

model skills {
  skill_id              Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  description           String?
  created_by            Int?
  branch_id             Int?
  shift_tasks           shift_tasks[]
  branches              branches?               @relation(fields: [branch_id], references: [branch_id], onUpdate: NoAction)
  users                 users?                  @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  user_skill_tags       user_skill_tags[]
  branch_role_templates branch_role_templates[]
  branch_skills         branch_skills[]

  @@unique([name, branch_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff {
  staff_id         Int                @id @default(autoincrement())
  user_id          Int
  branch_id        Int?
  staff_type       String             @db.VarChar(20)
  default_work_days String?           @db.VarChar(7)
  hired_at         DateTime?          @db.Date
  exp_level        String?            @db.VarChar(20)
  is_active        Boolean?           @default(true)
  availability     availability[]
  task_assignments task_assignments[]
  branches         branches?          @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
  users            users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model swap_requests {
  swap_id                                                                   Int               @id @default(autoincrement())
  requester_id                                                              Int
  requester_assign                                                          Int
  target_staff_id                                                           Int?
  target_assign_id                                                          Int?
  request_type                                                              String            @db.VarChar(20)
  reason                                                                    String?
  status                                                                    String            @default("pending") @db.VarChar(30)
  responded_at                                                              DateTime?         @db.Timestamp(6)
  manager_id                                                                Int?
  manager_decided_at                                                        DateTime?         @db.Timestamp(6)
  users                                                                     users?            @relation(fields: [manager_id], references: [user_id], onUpdate: NoAction)
  task_assignments_swap_requests_requester_assignTotask_assignments         task_assignments  @relation("swap_requests_requester_assignTotask_assignments", fields: [requester_assign], references: [assignment_id], onDelete: NoAction, onUpdate: NoAction)
  task_assignments_swap_requests_target_assign_idTotask_assignments         task_assignments? @relation("swap_requests_target_assign_idTotask_assignments", fields: [target_assign_id], references: [assignment_id], onUpdate: NoAction)

  @@index([requester_id], map: "idx_swap_requester")
}

model invitations {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  email       String    @db.VarChar(255)
  role        String    @db.VarChar(30)
  branch_id   Int?
  business_id Int?
  invited_by  Int
  status      String    @default("pending") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6)
  accepted_at DateTime? @db.Timestamptz(6)
  users       users     @relation(fields: [invited_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model branch_skills {
  id         Int      @id @default(autoincrement())
  branch_id  Int
  skill_id   Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  branches   branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade)
  skills     skills   @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade)

  @@unique([branch_id, skill_id])
}

model user_skill_tags {
  id                  Int      @id @default(autoincrement())
  user_id             Int
  skill_id            Int
  experience_level    String?
  years_of_experience Decimal?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  skills              skills   @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)
  users               users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, skill_id])
}

// P3, Category A: every `map: "outlet_..."` constraint/index name below (outlet_managers_pkey,
// outlet_settings_outlet_id_key, outlets_pkey, idx_shifts_outlet_date, staff_outlet_id_fkey, and
// the rest) is a REAL constraint/index name already live in Postgres, predating the
// Outlet → Branch rename. Editing the `map:` string alone would not rename anything in the
// database — it would just make Prisma disagree with what's actually there, and the next
// `migrate` would report drift. Renaming them for real needs an explicit
// `ALTER TABLE ... RENAME CONSTRAINT` / `ALTER INDEX ... RENAME TO` migration for each one, with
// every `map:` updated to match in the same commit. Deliberately not doing that here: renaming a
// live constraint/index has no functional benefit, and doing it "half" (schema only, or SQL only)
// is worse than doing neither. These names are retained on purpose, not missed.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DATABASE_URL is Supabase's pooled PgBouncer connection (transaction mode, port 6543) —
  // fine for the runtime client, but DDL (migrate/db push) needs a direct, non-pooled
  // connection or it hangs. DIRECT_URL (port 5432) already existed in .env for this.
  directUrl = env("DIRECT_URL")
}

// Append-only compliance/audit trail: who changed what, when, and the before/after state.
// Written by the backend on approval/rejection and shift edit/delete actions; never updated
// or deleted by application code.
model audit_logs {
  id         Int       @id @default(autoincrement())
  actor_id   Int?
  action     String    @db.VarChar(50)
  entity     String    @db.VarChar(50)
  entity_id  Int?
  before     Json?
  after      Json?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users?    @relation(fields: [actor_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([entity, entity_id])
  @@index([actor_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability {
  request_id  Int       @id @default(autoincrement())
  staff_id    Int
  leave_type  String    @db.VarChar(20)
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  reason      String?
  status      String    @default("pending") @db.VarChar(20)
  reviewed_by Int?
  reviewed_at DateTime? @db.Timestamp(6)
  users       users?    @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)
  staff       staff     @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
}

model branch_managers {
  id          Int      @id(map: "outlet_managers_pkey") @default(autoincrement())
  user_id     Int
  branch_id   Int
  is_primary  Boolean  @default(true)
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  branches    branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "outlet_managers_outlet_id_fkey")
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "outlet_managers_user_id_fkey")

  @@unique([user_id, branch_id], map: "outlet_managers_user_id_outlet_id_key")
  @@index([user_id], map: "idx_outlet_managers_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branch_settings {
  setting_id                 Int         @id(map: "outlet_settings_pkey") @default(autoincrement())
  branch_id                  Int         @unique(map: "outlet_settings_outlet_id_key")
  operating_days             String      @default("1111100")
  holidays                   Json        @default("[]")
  work_hours_day             Int         @default(8)
  max_work_hours_day         Int         @default(12)
  max_consecutive_days       Int         @default(6)
  allow_overtime             Boolean     @default(false)
  min_workers_per_assignment Int         @default(1)
  created_at                 DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime    @default(now()) @db.Timestamptz(6)
  off_days_per_week          Int?        @default(1)
  // Round 3, Task 3: when false (the default), shift generation skips any date listed in the
  // new public_holidays reference table for this branch, without the manager needing to add
  // each one to `holidays` individually. When true, generation runs through public holidays
  // normally. Independent of `holidays` below — a branch can still mark an individual date
  // closed via `holidays` even while this is true (e.g. "we work through public holidays
  // generally, except Christmas Day specifically").
  treat_public_holidays_as_working Boolean? @default(false)
  business_id                Int?
  // Picked once via the branch's Skill Tags panel (F&B / Clinic / Outlet, etc.) to filter the
  // skills.industry_type catalog into a relevant role-tag suggestion list. Per-branch rather than
  // on `businesses` — a single business can run branches in different industries.
  industry                   String?     @db.VarChar(30)
  businesses                 businesses? @relation(fields: [business_id], references: [business_id], onDelete: NoAction, onUpdate: NoAction)
  branches                   branches    @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "outlet_settings_outlet_id_fkey")
}

model branch_skills {
  id         Int       @id @default(autoincrement())
  branch_id  Int
  skill_id   Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  branches   branches  @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
  skills     skills    @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, skill_id])
}

// Was live in the database and already used by shiftController.js / businessOwnerController.js
// (prisma.branch_role_templates + raw supabase "branch_role_templates" calls) but had never been
// added to this schema file — reconstructed from a live introspection (columns, FK delete/update
// rules) rather than guessed, specifically so `prisma db push` stops wanting to drop this
// non-empty table.
model branch_role_templates {
  template_id Int      @id @default(autoincrement())
  branch_id   Int
  role_name   String   @db.VarChar
  skill_id    Int?
  headcount   Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  branches    branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
  skills      skills?  @relation(fields: [skill_id], references: [skill_id], onDelete: SetNull, onUpdate: NoAction)
}

// Round 3: the branch's normal task set per weekday, used by the shift-generation routine
// (Task 2) to populate generated shifts. day_of_week follows the same Monday-indexed
// convention as branch_settings.operating_days and casual_availability.day_of_week (Mon=0
// … Sun=6) — verified against shiftController.js's existing "day_of_week uses Mon=0…Sun=6"
// comment and its (getUTCDay()+6)%7 conversion, not assumed.
model branch_task_templates {
  template_id      Int       @id @default(autoincrement())
  branch_id        Int
  day_of_week      Int       @db.SmallInt
  title            String    @db.VarChar(100)
  skill_id         Int?
  start_time       DateTime? @db.Time(6)
  end_time         DateTime? @db.Time(6)
  required_workers Int       @default(1)
  sort_order       Int       @default(0)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  // Round 6, Task 2: which named shift period (Morning/Evening/…) this task belongs to. Nullable
  // — a template with no period lands in the branch's fallback "operating hours" shift at
  // generation time (see generateShiftsForBranch's own comment). ON DELETE SET NULL rather than
  // Cascade: deleting a period shouldn't silently delete the tasks that referenced it.
  period_id        Int?
  branches         branches  @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
  skills           skills?   @relation(fields: [skill_id], references: [skill_id], onDelete: SetNull, onUpdate: NoAction)
  branch_shift_periods branch_shift_periods? @relation(fields: [period_id], references: [period_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([branch_id, day_of_week], map: "idx_branch_task_templates_branch_day")
}

// Round 6, Task 2: named shift periods (e.g. "Morning" 08:00-16:00, "Evening" 16:00-00:00) a
// branch can define once, in settings. Every branch ends up with at least one — the backfill
// script (prisma/seed/branchShiftPeriodsBackfill.sql) gives every existing branch a single
// "Full Day" period spanning its existing open_time/close_time, so a branch with one continuous
// service generates exactly as it did before this round (see generateShiftsForBranch's own
// comment for the regression guarantee this makes possible).
model branch_shift_periods {
  period_id   Int      @id @default(autoincrement())
  branch_id   Int
  name        String   @db.VarChar(50)
  start_time  DateTime @db.Time(6)
  end_time    DateTime @db.Time(6)
  // Same convention as branch_settings.operating_days — Mon=index0…Sun=index6, '1' = this period
  // runs that day. Lets a branch run an evening period only on weekends, for example.
  active_days String   @default("1111111") @db.VarChar(7)
  sort_order  Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  branches    branches @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
  branch_task_templates branch_task_templates[]
  shift_tasks shift_tasks[]
  shifts      shifts[]
  casual_period_availability   casual_period_availability[]
  casual_standing_availability casual_standing_availability[]

  @@index([branch_id], map: "idx_branch_shift_periods_branch")
}

// OPT 5: day_of_week is nullable and additive — see prisma/seed/casualPeriodAvailabilityDayOfWeek.sql
// (applied to the database). NULL keeps the original "available all operating days this week for
// this period" meaning; 0-6 (Mon=0…Sun=6, same convention as
// casual_standing_availability.day_of_week) narrows that to one specific day. The real uniqueness
// guard on (staff_id, week_start_date, period_id, day_of_week) uses Postgres 15's
// UNIQUE ... NULLS NOT DISTINCT, which this declarative @@unique cannot express — the SQL file is
// the source of truth for that constraint; this attribute just keeps Prisma's own duplicate-input
// checks (e.g. createMany) aligned with it.
model casual_period_availability {
  id              Int                 @id @default(autoincrement())
  staff_id        Int
  week_start_date DateTime            @db.Date
  period_id       Int
  day_of_week     Int?                @db.SmallInt
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  staff           staff               @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)
  branch_shift_periods branch_shift_periods @relation(fields: [period_id], references: [period_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, week_start_date, period_id, day_of_week])
  @@index([staff_id, week_start_date], map: "idx_casual_period_availability_staff_week")
}

model casual_standing_availability {
  id          Int                 @id @default(autoincrement())
  staff_id    Int
  period_id   Int
  day_of_week Int                 @db.SmallInt
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  staff       staff               @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)
  branch_shift_periods branch_shift_periods @relation(fields: [period_id], references: [period_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, period_id, day_of_week])
  @@index([staff_id], map: "idx_casual_standing_availability_staff")
}

// Round 3, Task 3: a global reference list of gazetted public holidays, seeded once via
// prisma/seed/publicHolidays.sql (not a branch_settings-style per-branch list — every branch
// shares the same set of dates for a given country; whether a branch is OPEN or closed on one
// is governed by branch_settings.treat_public_holidays_as_working, and a branch can still
// override an individual date via branch_settings.holidays). Not used to store branch-specific
// ad-hoc closures — those stay in branch_settings.holidays, per the task's own instruction not
// to create a new table for that.
model public_holidays {
  holiday_id   Int      @id @default(autoincrement())
  country_code String   @default("SG") @db.VarChar(2)
  holiday_date DateTime @db.Date
  name         String   @db.VarChar(100)
  year         Int

  @@unique([country_code, holiday_date])
  @@index([country_code, year], map: "idx_public_holidays_country_year")
}

// Same situation as branch_role_templates above: live, already read/written via raw supabase
// calls in shiftController.js and casualController.js (the Phase 4 allocation-weight scoring),
// but absent from this schema file. Reconstructed from a live introspection.
model branch_allocation_preferences {
  id                  Int       @id @default(autoincrement())
  branch_id           Int       @unique
  weight_availability Int       @default(40)
  weight_skills       Int       @default(30)
  weight_attendance   Int       @default(15)
  weight_performance  Int       @default(10)
  weight_workload     Int       @default(5)
  updated_at          DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  branches            branches  @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branches {
  branch_id                 Int                         @id(map: "outlets_pkey") @default(autoincrement())
  name                      String                      @db.VarChar(100)
  address                   String?
  business_id               Int?
  open_time                 DateTime?                   @default(dbgenerated("'08:00:00'::time without time zone")) @db.Time(6)
  close_time                DateTime?                   @default(dbgenerated("'22:00:00'::time without time zone")) @db.Time(6)
  // P3, Category B: "outlet" here is one of three industry types (fnb | clinic | outlet, meaning
  // a retail store) — a genuinely different meaning from the pre-rename Outlet-Manager actor name
  // that Category A's constraint names refer to. Replacing it with "branch" would be wrong (a
  // branch is a location, this is an industry); the correct value if this ever gets renamed is
  // "retail", which needs a data migration (UPDATE existing rows) and a validation-allowlist
  // change in businessOwnerController.js — not done here, kept as-is.
  location_type             String                      @default("outlet") @db.VarChar(50)
  working_days              Int                         @default(7)
  deleted_at                DateTime?                   @db.Timestamptz(6)
  branch_managers           branch_managers[]
  branch_settings           branch_settings?
  branch_skills             branch_skills[]
  branch_role_templates     branch_role_templates[]
  branch_shift_periods      branch_shift_periods[]
  branch_task_templates     branch_task_templates[]
  branch_allocation_preferences branch_allocation_preferences?
  businesses                businesses?                 @relation(fields: [business_id], references: [business_id], onUpdate: NoAction, map: "outlets_business_id_fkey")
  casual_branch_preferences casual_branch_preferences[]
  invitations               invitations[]
  reports                   reports[]
  shifts                    shifts[]
  staff                     staff[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model businesses {
  business_id            Int                     @id @default(autoincrement())
  name                   String                  @db.VarChar(150)
  description            String?
  created_at             DateTime?               @default(now()) @db.Timestamptz(6)
  owner_id               Int?
  industry               String?                 @db.VarChar(100)
  contact_email          String?                 @db.VarChar(255)
  contact_phone          String?                 @db.VarChar(30)
  address                String?
  website                String?                 @db.VarChar(255)
  plan                   String                  @default("free") @db.VarChar(20)
  scheduling_mode        String                  @default("shift") @db.VarChar(20)
  // P3 finding — a fourth, previously unlisted meaning of "outlet": a per-business customizable
  // display noun for what this business calls its locations (same idea as staff_label defaulting
  // to "Staff"), NOT a constraint name (Category A) or the industry-type value (Category B).
  // Currently dead — no controller or frontend/mobile code reads or writes location_label at all,
  // so its default of "Outlet" is never actually displayed anywhere today. Left as-is: whether to
  // wire it up, rename its default, or drop the unused column is a product decision, not a stale
  // reference to clean up.
  location_label         String                  @default("Outlet") @db.VarChar(50)
  staff_label            String                  @default("Staff") @db.VarChar(50)
  join_code              String?                 @unique @db.VarChar(12)
  default_casual_hours   Decimal?                @default(20) @db.Decimal
  allocation_preferences allocation_preferences?
  branch_settings        branch_settings[]
  branches               branches[]
  business_roles         business_roles[]
  business_settings      business_settings?
  casual_workers         casual_workers[]
  skills                 skills[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model casual_availability {
  availability_id Int       @id @default(autoincrement())
  staff_id        Int
  week_start_date DateTime  @db.Date
  day_of_week     Int       @db.SmallInt
  available_from  DateTime  @db.Time(6)
  available_to    DateTime  @db.Time(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  staff           staff     @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([staff_id, week_start_date, day_of_week])
  @@index([staff_id, week_start_date], map: "idx_casual_availability_staff_week")
}

model casual_branch_preferences {
  id         Int       @id @default(autoincrement())
  user_id    Int
  branch_id  Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  branches   branches  @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "casual_branch_preferences_outlet_id_fkey")
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, branch_id], map: "casual_branch_preferences_user_id_outlet_id_key")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model casual_workers {
  id          BigInt     @id @default(autoincrement())
  user_id     Int
  business_id Int
  status      String     @default("pending") @db.VarChar(20)
  bio         String?
  joined_at   DateTime   @default(now()) @db.Timestamptz(6)
  approved_at DateTime?  @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [business_id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, business_id])
  @@index([business_id])
  @@index([status])
  @@index([user_id])
}

model invitations {
  id              Int       @id @default(autoincrement())
  token           String    @unique @db.VarChar(64)
  email           String    @db.VarChar(255)
  role            String    @db.VarChar(30)
  branch_id       Int?
  business_id     Int?
  invited_by      Int
  status          String    @default("pending") @db.VarChar(20)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  expires_at      DateTime  @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(6)
  accepted_at     DateTime? @db.Timestamptz(6)
  invitation_code String?   @unique @db.VarChar(10)
  accepted_by     Int?
  users           users?    @relation(fields: [accepted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  branches        branches? @relation(fields: [branch_id], references: [branch_id], onUpdate: NoAction, map: "invitations_outlet_id_fkey")
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  recipient_id    Int
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  message         String?
  related_entity  String?   @db.VarChar(50)
  related_id      Int?
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [recipient_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model off_day_requests {
  id                                        Int       @id @default(autoincrement())
  staff_id                                  Int
  requested_date                            DateTime  @db.Date
  reason                                    String?
  status                                    String    @default("pending")
  created_at                                DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at                               DateTime? @db.Timestamptz(6)
  reviewed_by                               Int?
  staff_off_day_requests_reviewed_byTostaff staff?    @relation("off_day_requests_reviewed_byTostaff", fields: [reviewed_by], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
  staff_off_day_requests_staff_idTostaff    staff     @relation("off_day_requests_staff_idTostaff", fields: [staff_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)
}

model reports {
  report_id    Int       @id @default(autoincrement())
  branch_id    Int?
  generated_by Int
  report_type  String    @db.VarChar(50)
  period_start DateTime  @db.Date
  period_end   DateTime  @db.Date
  parameters   Json?
  result_data  Json?
  format       String    @default("csv") @db.VarChar(10)
  title        String?   @db.VarChar(200)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  users        users     @relation(fields: [generated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  branches     branches? @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "reports_outlet_id_fkey")
}

model shift_tasks {
  task_id          Int                @id @default(autoincrement())
  shift_id         Int
  title            String             @db.VarChar(100)
  description      String?
  skill_id         Int?
  start_time       DateTime?          @db.Time(6)
  end_time         DateTime?          @db.Time(6)
  status           String             @default("open") @db.VarChar(20)
  difficulty       String?            @db.VarChar(20)
  // Round 6, Task 2/6: copied from the generating template's period at creation time (same
  // "copy, never reference" pattern as title/skill_id/start_time/end_time) — lets Task 6's
  // availability matching know which period this task belongs to without re-deriving it from
  // times that may have been edited since generation.
  period_id        Int?
  shifts           shifts             @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  skills           skills?            @relation(fields: [skill_id], references: [skill_id], onUpdate: NoAction)
  branch_shift_periods branch_shift_periods? @relation(fields: [period_id], references: [period_id], onDelete: SetNull, onUpdate: NoAction)
  task_assignments task_assignments[]

  @@index([shift_id], map: "idx_shift_tasks_shift")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shifts {
  shift_id         Int                @id @default(autoincrement())
  branch_id        Int
  title            String?            @db.VarChar(100)
  shift_date       DateTime           @db.Date
  start_time       DateTime           @db.Time(6)
  end_time         DateTime           @db.Time(6)
  status           String             @default("draft") @db.VarChar(20)
  created_by       Int?
  shift_type       String             @default("regular") @db.VarChar(30)
  deadline         DateTime?          @db.Date
  // Round 3, Task 2: distinguishes shifts created by the template-based generation routine from
  // manually created ones, so generation can skip a date a manager already handled by hand and
  // the UI can show which is which. Nullable (not defaulted) so every pre-existing row reads as
  // NULL — application code treats NULL the same as "manual", exactly its prior behaviour.
  source           String?            @db.VarChar(20)
  // Round 6, Task 2: which named period this generated shift represents (null for a branch with
  // no periods, and null for the single fallback shift covering null-period templates on a
  // branch that DOES have periods). Needed so re-running generation can tell "Morning already
  // generated for this date" apart from "Evening already generated for this date" — without this,
  // idempotency could only be checked per date, not per date+period.
  period_id        Int?
  shift_tasks      shift_tasks[]
  users            users?             @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  branches         branches           @relation(fields: [branch_id], references: [branch_id], onDelete: Cascade, onUpdate: NoAction, map: "shifts_outlet_id_fkey")
  branch_shift_periods branch_shift_periods? @relation(fields: [period_id], references: [period_id], onDelete: SetNull, onUpdate: NoAction)
  task_assignments task_assignments[]

  @@index([branch_id, shift_date], map: "idx_shifts_outlet_date")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id         Int               @id @default(autoincrement())
  username        String            @db.VarChar(100)
  email           String            @unique @db.VarChar(100)
  role            String            @db.VarChar(30)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  full_name       String?           @db.VarChar(100)
  attendance      attendance[]
  availability    availability[]
  invitations     invitations[]
  krewby_workers  krewby_workers[]
  notifications   notifications[]
  reports         reports[]
  shifts          shifts[]
  skills          skills[]
  staff           staff[]
  swap_requests         swap_requests[]
  user_skill_tags       user_skill_tags[]
  projects_created      projects[]
  timesheets_reviewed   timesheets[]      @relation("timesheet_reviewer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  attendance_id     Int               @id @default(autoincrement())
  assignment_id     Int
  clock_in          DateTime?         @db.Timestamp(6)
  clock_out         DateTime?         @db.Timestamp(6)
  status            String            @default("pending") @db.VarChar(20)
  marked_by         Int
  marked_at         DateTime?         @default(now()) @db.Timestamp(6)
  shift_assignments shift_assignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [marked_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability {
  request_id  Int       @id @default(autoincrement())
  staff_id    Int
  leave_type  String    @db.VarChar(20)
  start_date  DateTime  @db.Date
  end_date    DateTime  @db.Date
  reason      String?
  status      String    @default("pending") @db.VarChar(20)
  reviewed_by Int?
  reviewed_at DateTime? @db.Timestamp(6)
  users       users?    @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)
  staff       staff     @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model casual_availability {
  availability_id Int       @id @default(autoincrement())
  staff_id        Int
  week_start_date DateTime  @db.Date
  day_of_week     Int       @db.SmallInt
  available_from  DateTime? @db.Time(6)
  available_to    DateTime? @db.Time(6)

  @@unique([staff_id, week_start_date, day_of_week])
}

model krewby_workers {
  krewby_worker_id   Int                 @id @default(autoincrement())
  user_id            Int
  preferred_location String?
  rating             Decimal?            @default(5.00) @db.Decimal(3, 2)
  total_jobs         Int?                @default(0)
  is_active          Boolean?            @default(true)
  users              users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  shift_assignments  shift_assignments[]
}

model notifications {
  notification_id Int       @id @default(autoincrement())
  recipient_id    Int
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(200)
  message         String?
  related_entity  String?   @db.VarChar(50)
  related_id      Int?
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users     @relation(fields: [recipient_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model outlets {
  outlet_id              Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(100)
  address                String?
  business_id            Int?
  open_time              DateTime?                @db.Time
  close_time             DateTime?                @db.Time
  location_type          String                   @default("outlet") @db.VarChar(50)
  reports                reports[]
  shifts                 shifts[]
  skills                 skills[]
  staff                  staff[]
  outlet_role_templates  outlet_role_templates[]
  projects               projects[]
  services               services[]
  bookings               bookings[]
}

model outlet_role_templates {
  template_id             Int      @id @default(autoincrement())
  outlet_id               Int
  role_name               String   @db.VarChar(100)
  skill_id                Int?
  headcount               Int      @default(1)
  min_experience_level    String   @default("beginner") @db.VarChar(20)
  requires_certification  Boolean  @default(false)
  certification_name      String?  @db.VarChar(100)
  created_at              DateTime @default(now()) @db.Timestamptz
  outlets                 outlets  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade)
  skills                  skills?  @relation(fields: [skill_id], references: [skill_id], onDelete: SetNull)
}

model staff_certifications {
  cert_id     Int       @id @default(autoincrement())
  staff_id    Int
  cert_name   String    @db.VarChar(100)
  issued_date DateTime? @db.Date
  expiry_date DateTime? @db.Date
  created_at  DateTime  @default(now()) @db.Timestamptz
  staff       staff     @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)
}

model reports {
  report_id    Int      @id @default(autoincrement())
  outlet_id    Int
  generated_by Int
  report_type  String   @db.VarChar(50)
  period_start DateTime @db.Date
  period_end   DateTime @db.Date
  parameters   Json?
  result_data  Json?
  users        users    @relation(fields: [generated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  outlets      outlets  @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shift_assignments {
  assignment_id                                                   Int             @id @default(autoincrement())
  shift_id                                                        Int
  role_id                                                         Int
  staff_id                                                        Int?
  krewby_worker_id                                                Int?
  status                                                          String          @default("assigned") @db.VarChar(20)
  acknowledged                                                    Boolean?        @default(false)
  assigned_at                                                     DateTime?       @default(now()) @db.Timestamp(6)
  attendance                                                      attendance[]
  krewby_workers                                                  krewby_workers? @relation(fields: [krewby_worker_id], references: [krewby_worker_id], onUpdate: NoAction)
  shift_roles                                                     shift_roles     @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)
  shifts                                                          shifts          @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  staff                                                           staff?          @relation(fields: [staff_id], references: [staff_id], onDelete: NoAction, onUpdate: NoAction)
  swap_requests_swap_requests_requester_assignToshift_assignments swap_requests[] @relation("swap_requests_requester_assignToshift_assignments")
  swap_requests_swap_requests_target_assign_idToshift_assignments swap_requests[] @relation("swap_requests_target_assign_idToshift_assignments")

  @@index([shift_id], map: "idx_assignments_shift")
  @@index([staff_id], map: "idx_assignments_staff")
}

model shift_roles {
  role_id           Int                 @id @default(autoincrement())
  shift_id          Int
  role_name         String              @db.VarChar(100)
  skill_id          Int?
  headcount         Int                 @default(1)
  shift_assignments shift_assignments[]
  shifts            shifts              @relation(fields: [shift_id], references: [shift_id], onDelete: Cascade, onUpdate: NoAction)
  skills            skills?             @relation(fields: [skill_id], references: [skill_id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model shifts {
  shift_id          Int                 @id @default(autoincrement())
  outlet_id         Int
  title             String?             @db.VarChar(100)
  shift_date        DateTime            @db.Date
  start_time        DateTime            @db.Time(6)
  end_time          DateTime            @db.Time(6)
  status            String              @default("draft") @db.VarChar(20)
  shift_type        String              @default("regular") @db.VarChar(30)
  created_by        Int?
  shift_assignments shift_assignments[]
  shift_roles       shift_roles[]
  users             users?              @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  outlets           outlets             @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([outlet_id, shift_date], map: "idx_shifts_outlet_date")
}

model skills {
  skill_id              Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(100)
  description           String?
  created_by            Int?
  outlet_id             Int?
  business_id           Int?
  industry_type         String?                 @db.VarChar(30)
  is_catalog            Boolean                 @default(false)
  shift_roles           shift_roles[]
  outlets               outlets?                @relation(fields: [outlet_id], references: [outlet_id], onUpdate: NoAction)
  users                 users?                  @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  user_skill_tags       user_skill_tags[]
  outlet_role_templates outlet_role_templates[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff {
  staff_id            Int                 @id @default(autoincrement())
  user_id             Int
  outlet_id           Int
  staff_type          String              @db.VarChar(20)
  default_work_days   String?             @db.VarChar(7)
  hired_at            DateTime?           @db.Date
  is_active           Boolean?            @default(true)
  experience_level      String                 @default("intermediate") @db.VarChar(20)
  years_of_experience   Decimal?               @db.Decimal(4, 1)
  availability          availability[]
  shift_assignments     shift_assignments[]
  staff_certifications  staff_certifications[]
  project_assignments   project_assignments[]
  timesheets            timesheets[]
  bookings              bookings[]
  outlets             outlets             @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, onUpdate: NoAction)
  users               users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model swap_requests {
  swap_id                                                             Int                @id @default(autoincrement())
  requester_id                                                        Int
  requester_assign                                                    Int
  target_staff_id                                                     Int?
  target_assign_id                                                    Int?
  request_type                                                        String             @db.VarChar(20)
  reason                                                              String?
  status                                                              String             @default("pending") @db.VarChar(30)
  responded_at                                                        DateTime?          @db.Timestamp(6)
  manager_id                                                          Int?
  manager_decided_at                                                  DateTime?          @db.Timestamp(6)
  users                                                               users?             @relation(fields: [manager_id], references: [user_id], onUpdate: NoAction)
  shift_assignments_swap_requests_requester_assignToshift_assignments shift_assignments  @relation("swap_requests_requester_assignToshift_assignments", fields: [requester_assign], references: [assignment_id], onDelete: NoAction, onUpdate: NoAction)
  shift_assignments_swap_requests_target_assign_idToshift_assignments shift_assignments? @relation("swap_requests_target_assign_idToshift_assignments", fields: [target_assign_id], references: [assignment_id], onUpdate: NoAction)

  @@index([requester_id], map: "idx_swap_requester")
}

model invitations {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  email       String    @db.VarChar(255)
  role        String    @db.VarChar(30)
  outlet_id   Int?
  business_id Int?
  invited_by  Int
  status      String    @default("pending") @db.VarChar(20)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6)
  accepted_at DateTime? @db.Timestamptz(6)
  users       users     @relation(fields: [invited_by], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_skill_tags {
  id                Int    @id @default(autoincrement())
  user_id           Int
  skill_id          Int
  proficiency_level String @default("intermediate") @db.VarChar(20)
  skills            skills @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade, onUpdate: NoAction)
  users             users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, skill_id])
}

model projects {
  project_id          Int                  @id @default(autoincrement())
  business_id         Int
  location_id         Int?
  name                String               @db.VarChar(150)
  description         String?
  status              String               @default("active") @db.VarChar(20)
  start_date          DateTime?            @db.Date
  end_date            DateTime?            @db.Date
  color               String?              @default("#6366F1") @db.VarChar(7)
  created_by          Int?
  created_at          DateTime             @default(now()) @db.Timestamptz
  users               users?               @relation(fields: [created_by], references: [user_id], onDelete: SetNull)
  outlets             outlets?             @relation(fields: [location_id], references: [outlet_id], onDelete: SetNull)
  project_assignments project_assignments[]
  timesheets          timesheets[]
}

model project_assignments {
  pa_id            Int      @id @default(autoincrement())
  project_id       Int
  staff_id         Int
  role_on_project  String?  @db.VarChar(100)
  estimated_hours  Decimal  @default(0) @db.Decimal(6,1)
  created_at       DateTime @default(now()) @db.Timestamptz
  projects         projects @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  staff            staff    @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)

  @@unique([project_id, staff_id])
}

model timesheets {
  timesheet_id  Int       @id @default(autoincrement())
  staff_id      Int
  project_id    Int?
  task_id       Int?
  log_date      DateTime  @db.Date
  hours_worked  Decimal   @db.Decimal(4,1)
  description   String?
  status        String    @default("pending") @db.VarChar(20)
  reviewed_by   Int?
  reviewed_at   DateTime? @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  staff         staff     @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)
  projects      projects? @relation(fields: [project_id], references: [project_id], onDelete: SetNull)
  reviewer      users?    @relation("timesheet_reviewer", fields: [reviewed_by], references: [user_id], onDelete: SetNull)

  @@unique([staff_id, project_id, log_date])
}

model services {
  service_id      Int       @id @default(autoincrement())
  outlet_id       Int
  name            String    @db.VarChar(150)
  duration_mins   Int       @default(60)
  requires_skill  String?   @db.VarChar(100)
  color           String?   @default("#6366F1") @db.VarChar(7)
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz
  outlets         outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade)
  bookings        bookings[]
}

model bookings {
  booking_id         Int       @id @default(autoincrement())
  outlet_id          Int
  service_id         Int?
  customer_name      String    @db.VarChar(150)
  customer_phone     String?   @db.VarChar(30)
  booking_date       DateTime  @db.Date
  start_time         DateTime  @db.Time(6)
  end_time           DateTime  @db.Time(6)
  assigned_staff_id  Int?
  status             String    @default("confirmed") @db.VarChar(20)
  notes              String?
  created_at         DateTime  @default(now()) @db.Timestamptz
  outlets            outlets   @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade)
  services           services? @relation(fields: [service_id], references: [service_id], onDelete: SetNull)
  staff              staff?    @relation(fields: [assigned_staff_id], references: [staff_id], onDelete: SetNull)

  @@index([outlet_id, booking_date])
}
